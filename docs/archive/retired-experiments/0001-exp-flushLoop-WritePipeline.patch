仅用于量化两级队列的开销：语义与 WritePipeline.runBatch 一致
（异常整批 markFailed，finally 保证 done），全量 375/375 通过。
---
 src/db/badger.cj | 26 ++++++++++++++++++++++----
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/src/db/badger.cj b/src/db/badger.cj
index c123421..beb1ecf 100644
--- a/src/db/badger.cj
+++ b/src/db/badger.cj
@@ -950,6 +950,26 @@ public class Badger <: VLogGCDB {
     }
 
 // Collect requests and emit to pipeline
+    // 实验：单级写路径 —— flushLoop 直接处理批次，语义与 WritePipeline.runBatch 一致
+    // （异常整批 markFailed，finally 保证 done），省掉一次队列投递与一次线程唤醒。
+    private func writeBatchDirect(reqs: ArrayList<WriteRequest>): Unit {
+        try {
+            writeRequests(reqs)
+        } catch (e: Exception) {
+            for (req in reqs) {
+                req.markFailed(failureMsg(e))
+            }
+        } catch (e: Error) {
+            for (req in reqs) {
+                req.markFailed(systemFailureMsg(e))
+            }
+        } finally {
+            for (req in reqs) {
+                req.done()
+            }
+        }
+    }
+
     private func flushLoop(): Unit {
         while (running.load()) {
             if (let Some(req) <- writeCh.remove()) {
@@ -965,10 +985,8 @@ public class Badger <: VLogGCDB {
                     }
                 }
                 
-                // Emit to pipeline (async)
-                if (let Some(p) <- pipeline) {
-                    p.emit(reqs)
-                }
+                // 实验：单级写路径（直接处理批次，不再经 WritePipeline 二级队列）
+                writeBatchDirect(reqs)
             }
         }
         
